{
  "name": "adaptpractice",
  "version": "1.0.0",
  "private": true,
  "description": "AdaptPractice — adaptive learning platform, self-hosted, with a real Claude API backend.",
  "type": "commonjs",
  "main": "server/server.js",
  "scripts": {
    "start": "USE_OLLAMA=true OLLAMA_MODEL=${OLLAMA_MODEL:-qwen2.5:3b} node server/server.js",
    "start:claude": "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY} CLAUDE_MODEL=${CLAUDE_MODEL:-claude-sonnet-5} node server/server.js",
    "dev": "USE_OLLAMA=true OLLAMA_MODEL=${OLLAMA_MODEL:-qwen2.5:3b} node --watch server/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsdom": "^30.1.0"
  }
}
