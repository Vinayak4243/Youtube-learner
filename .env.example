# Copy this file to ".env" and fill in the values you need. Never commit ".env".
# This project defaults to a free local Ollama model instead of paid Anthropic API credits.
ANTHROPIC_API_KEY=
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Anthropic settings are used only if USE_OLLAMA is false and the API key is set.
CLAUDE_MODEL=claude-sonnet-5

# Comma-separated list of origins allowed to call this API.
# Leave empty for local development. Set to your real domain before deploying,
# e.g. https://www.yoursite.com
ALLOWED_ORIGINS=

PORT=8787
